{
  "name": "@claude-worker/react",
  "version": "0.4.0",
  "type": "module",
  "description": "Headless React layer for claude-worker: useClaudeSession hook + pure transcript reducer. No styling opinion — @claude-worker/ui is the styled layer on top.",
  "license": "MIT",
  "main": "./build/index.mjs",
  "types": "./build/index.d.mts",
  "files": [
    "build"
  ],
  "exports": {
    ".": {
      "@claude-worker/source": "./src/index.ts",
      "types": "./build/index.d.mts",
      "default": "./build/index.mjs"
    }
  },
  "scripts": {
    "clean": "rimraf build",
    "build": "tsdown",
    "prepack": "pnpm clean && pnpm build",
    "typecheck": "tsgo -p tsconfig.json && tsgo -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@claude-worker/client": "0.4.0",
    "@claude-worker/protocol": "0.4.0",
    "@claude-worker/sandbox": "0.4.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "@jitl/quickjs-singlefile-browser-release-asyncify": "^0.31.0"
  },
  "peerDependenciesMeta": {
    "@jitl/quickjs-singlefile-browser-release-asyncify": {
      "optional": true
    }
  },
  "devDependencies": {
    "@claude-worker/core": "0.4.0",
    "@claude-worker/server": "0.4.0",
    "@jitl/quickjs-ng-wasmfile-release-asyncify": "^0.31.0",
    "@jitl/quickjs-singlefile-browser-release-asyncify": "^0.31.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/ws": "^8.18.1",
    "react": "^19.2.0",
    "rimraf": "^6.1.3",
    "tsdown": "^0.21.10",
    "vitest": "^3.2.0",
    "ws": "^8.21.1"
  },
  "author": "Tobias Strebitzer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobiasstrebitzer/claude-worker.git",
    "directory": "packages/react"
  },
  "homepage": "https://tobiasstrebitzer.github.io/claude-worker/",
  "bugs": "https://github.com/tobiasstrebitzer/claude-worker/issues",
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "agent",
    "react",
    "hooks",
    "headless"
  ],
  "publishConfig": {
    "access": "public"
  }
}
